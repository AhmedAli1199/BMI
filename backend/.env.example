ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bmi
CORS_ORIGINS=["http://localhost:3000"]
API_KEY=dev-only-change-me

# Follow-up Engine + Morning Queue - see app/automations/followup_queue.py.
# Scan is OFF until you set this to true (and restart).
AUTOMATIONS_FOLLOWUP_SCAN_ENABLED=false

# How far the scan looks for "due" Activities. Defaults (14 back / 1 ahead)
# assume forward-looking live usage - widen these if your data is mostly
# historical (e.g. right after a migration, nothing scheduled for the
# future yet) so the scan actually finds something to surface.
FOLLOWUP_LOOKBACK_DAYS=14
FOLLOWUP_LOOKAHEAD_DAYS=1
FOLLOWUP_MAX_PER_RUN=40

# OpenAI - powers the AI-drafted follow-up text (app/automations/llm.py),
# the vision-based intake automations, and bounce/OOO classification.
# Leave blank and everything still runs, just with plainer heuristic-only
# behaviour instead of AI-assisted wording - never required for these
# features to work at all.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Microsoft Graph app registration (client-credentials, app-only - see
# app/graph_client.py). Required for /api/diagnostics/graph-mailboxes and
# the CS-001/002/003 mailbox scans. Get these from the Azure app
# registration IT set up (Application permissions, admin-consented, e.g.
# Mail.Read) - never the Delegated kind, which client_credentials can't use.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# CS-001 + CS-002 (bounce classification, OOO mining) - see
# app/automations/bounce_handling.py. Scan is OFF until you set this to
# true (and restart) - confirm /api/diagnostics/graph-mailboxes reports
# "ok" for these addresses first.
AUTOMATIONS_BOUNCE_SCAN_ENABLED=false

# Comma-separated mailbox addresses the scan actually reads. Leave blank
# and the scan logs a message and does nothing, even if enabled above.
GRAPH_SCAN_MAILBOXES=

# How far back the very first scan of a mailbox looks, before it has its
# own "since last run" cursor to resume from.
BOUNCE_SCAN_INITIAL_LOOKBACK_MINUTES=1440

# SALES-010-lite (Email Exchange Summarising) - see
# app/automations/email_summary.py. Scan is OFF until you set this true
# (and restart).
AUTOMATIONS_EMAIL_SUMMARY_SCAN_ENABLED=false

# Whose mailboxes to read for real sales-conversation signals (budget
# windows, renewal dates, promised call-backs, personal touchpoints) -
# deliberately the "Sales/Mail Merges" roster, not the "Data Manager/Mail
# Merges" one: the data-manager mailboxes run bulk campaigns and data
# hygiene, not 1:1 client relationships, so they're where CS-001/002's
# bounce/OOO scan belongs (GRAPH_SCAN_MAILBOXES above), not this one.
# Clare Hunter (Administrator - runs the CRM system itself) is excluded
# for the same reason. Only ever reads threads that already match an
# existing Contact - see the module docstring for the full filter list.
GRAPH_EMAIL_SUMMARY_MAILBOXES=kirsty.hicks@bmipublishing.co.uk,neil.dargie@bmipublishing.co.uk,steven.thompson@bmipublishing.co.uk,sally.parker@bmipublishing.co.uk,david.wilcox@bmipublishing.co.uk,craig.mcquinn@bmipublishing.co.uk,sue.williams@onboardhospitality.com

# Drop anything with more people on the thread than this - a busy group
# thread isn't a 1:1 sales conversation - and anything shorter than this
# many characters - a bare "Thanks!" has nothing to extract.
EMAIL_SUMMARY_MAX_RECIPIENTS=3
EMAIL_SUMMARY_MIN_BODY_CHARS=40
EMAIL_SUMMARY_INITIAL_LOOKBACK_MINUTES=1440

# CS-004 (duplicate/moved-person merge) - see app/automations/dedupe.py.
# Scan is OFF until you set this to true (and restart).
AUTOMATIONS_DEDUPE_SCAN_ENABLED=false

# DEDUPE_MAX_PER_RUN caps how many candidate pairs get queued in one run.
# DEDUPE_BATCH_SIZE is a different, more important cap: how many contacts
# the scan drives through the trigram match per run (a cursor sweeps the
# whole table over successive runs). Keep this conservative - it bounds
# real query cost, and too high a value can outrun your database's own
# statement timeout on a large contacts table.
DEDUPE_MAX_PER_RUN=30
DEDUPE_CONFIDENCE_FLOOR=0.55
DEDUPE_BATCH_SIZE=500
