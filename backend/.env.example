ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bmi
CORS_ORIGINS=["http://localhost:3000"]
API_KEY=dev-only-change-me

# Follow-up Engine + Morning Queue - see app/automations/followup_queue.py.
# Scan is OFF until you set this to true (and restart).
AUTOMATIONS_FOLLOWUP_SCAN_ENABLED=false

# OpenAI - powers the AI-drafted follow-up text (app/automations/llm.py).
# Leave blank and the scan still runs, just with a plain templated draft
# instead of an AI-personalized one - never required for the feature to work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
